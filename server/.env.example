# ===========================================================================
# server/.env.example — 数据库连接配置模板
# ---------------------------------------------------------------------------
# 使用方法：把本文件复制为同目录下的 .env，按本机情况修改。
#   cp server/.env.example server/.env
#
# 优先级：进程环境变量 > server/.env > 代码内默认值（config.js）
# 本机（课程环境）默认即为 root 无密码，因此 .env 里 DB_PASSWORD 留空即可。
# ===========================================================================

# ---------- HTTP 服务 ----------
# 监听地址：127.0.0.1 仅本机可访问；0.0.0.0 允许局域网访问
SERVER_HOST=127.0.0.1
# 服务端口（同时提供 API 与前端静态站点）
SERVER_PORT=8090
# 是否同时托管前端静态文件：1 开启（默认）/ 0 关闭（只提供 API）
SERVE_STATIC=1

# ---------- MySQL 连接 ----------
DB_HOST=127.0.0.1
DB_PORT=3306
# 数据库账号：本机为 root
DB_USER=root
# 数据库口令：本机 root 无密码，这里保持空值即可
DB_PASSWORD=
# 数据库名（执行 sql/01-schema.sql 会自动创建）
DB_NAME=diabetes_assistant
# 连接池大小
DB_POOL_SIZE=10

# ---------- 启动行为 ----------
# 启动服务时是否自动执行建库建表 + 种子数据：1 开启 / 0 关闭（默认）
# 演示时设为 1 可以「一条命令从零到可用」
AUTO_INIT_DB=0
